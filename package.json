{
  "name": "dsh-client-ui-quote",
  "version": "0.13.0",
  "description": "Turn any DSH selection into a reviewable quote — comment / add to chat / side chat, source highlights and jump-back, a searchable review list, side threads, revisions, and per-quote reply badges.",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "BangBang-03",
  "repository": {
    "type": "git",
    "url": "https://github.com/BangBang-03/dsh-client-ui-quote.git"
  },
  "homepage": "https://github.com/BangBang-03/dsh-client-ui-quote#readme",
  "bugs": {
    "url": "https://github.com/BangBang-03/dsh-client-ui-quote/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quote",
    "selection",
    "comment",
    "annotation",
    "review",
    "kimi-code"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "locale",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/check.mjs && node test/capsule.mjs && node test/panel.mjs && node test/host.mjs",
    "prepublishOnly": "node test/check.mjs && node test/capsule.mjs && node test/panel.mjs && node test/host.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
